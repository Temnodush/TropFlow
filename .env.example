# =============================================================================
#  Шаблон переменных окружения проекта TropFlow.
#
#  Скопируйте файл в .env и заполните значения:
#      Windows:      copy .env.example .env
#      Linux/macOS:  cp .env.example .env
#
#  ВАЖНО: файл .env в репозиторий не попадает (см. .gitignore) и в Docker-образ
#  не копируется (см. .dockerignore). Секреты храните только в .env и в
#  GitHub Secrets.
#
#  При запуске через docker compose значения DB_HOST и REDIS_HOST заменяются
#  на имена сервисов (db и redis) автоматически — см. docker-compose.yml.
#  Значения 127.0.0.1 ниже нужны для локального запуска без Docker.
#
#  Символ $ в значениях использовать нельзя: docker compose считает его
#  подстановкой переменной.
# =============================================================================

# --- Django ---
# Обязательно. Сгенерировать новый ключ:
#   python -c "import secrets, string; a=string.ascii_letters+string.digits+'!@#%^&*(-_=+)'; print(''.join(secrets.choice(a) for _ in range(50)))"
SECRET_KEY_DJANGO=

# Режим отладки: True — только локально, False — на сервере
DEBUG=False

# Хосты, с которых разрешено обращаться к приложению (через запятую).
# Локально: localhost. На сервере: публичный IP или домен.
ALLOWED_HOSTS=localhost,127.0.0.1

# Источники, которым доверяем CSRF (нужны для входа в админку и Swagger).
# Формат — со схемой http:// или https://, через запятую.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Домены фронтенда, которым разрешены CORS-запросы
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Часовой пояс (IANA). В нём указывается время привычек и работает Celery beat
TIME_ZONE=Asia/Yekaterinburg

# --- Telegram ---
# Токен бота от @BotFather. Если пустой — напоминания не отправляются,
# остальной проект работает.
TELEGRAM_BOT_TOKEN=

# --- PostgreSQL ---
# Эти же значения использует контейнер db: менять их нужно только здесь.
POSTGRES_DB=tropflow
POSTGRES_USER=tropflow
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Docker Compose ---
# Порт, на который Nginx публикует приложение на хост-машине
WEB_PORT=8000

# Количество воркеров Gunicorn
GUNICORN_WORKERS=3
