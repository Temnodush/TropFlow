# --- Переменные окружения (секреты в репозиторий не попадают) ---
/.env
/.env.template

# --- Виртуальные окружения ---
/.venv/
/venv/
env/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/

# --- Django ---
*.sqlite3
/media/
/staticfiles/

# --- Celery ---
celerybeat-schedule*
celerybeat.pid

# --- Тесты и покрытие ---
.coverage
.coverage.*
coverage.txt
coverage.xml
htmlcov/
.pytest_cache/
.pytest_tmp_cache/
pytest-cache-files-*/

# --- Логи и pid-файлы сервисов ---
*.log
*.pid

# --- IDE и ОС ---
/.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store
